{
  "name": "drift-belt-operations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "bun --watch server.ts",
    "host": "bun run build && bun server.ts",
    "serve": "bun server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test",
    "test:browser": "node scripts/browser-check.mjs",
    "test:mission": "node scripts/browser-check.mjs --mission",
    "test:mp": "node scripts/mp-check.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/three": "^0.183.1",
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
